<?xml version="1.0" encoding="utf-8"?>
<!-- Quirky IDE v10 — replaces the old global android:usesCleartextTraffic="true".
     Cleartext HTTP is permitted ONLY to the loopback PHP servers (127.0.0.1 /
     localhost, ports 8080-8084 incl. preview micro-servers and LAN debug).
     Every other host must use HTTPS. On minSdk 24+ this config takes
     precedence over the manifest attribute (which we removed). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
